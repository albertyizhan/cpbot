# 从 BotFather 获取的独立机器人 Token
BOT_TOKEN=
# superadmin 名单，多个 ID 用逗号分隔，修改后重启生效
SUPERADMIN_IDS=
# 兼容旧 SUPERADMIN_ID；两项同时设置时取并集
DATABASE_PATH=data/cpbot.sqlite3
# Python/SQLite 默认。完成迁移后设置为 go，再重装 systemd 服务入口。
CPBOT_ENGINE=python
# Go 模式需要 cpbot 独立的 PostgreSQL 数据库。
DATABASE_URL=
# 启用私聊「查车评」按钮。小程序服务单独运行，由 HTTPS 反代转发。
CPBOT_MINI_APP_URL=
CPBOT_MINI_APP_LISTEN=127.0.0.1:8091
