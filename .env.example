# cpbot 的 BotFather Token
BOT_TOKEN=

# Superadmin 的 Telegram 数字 ID，多个 ID 用逗号分隔
# 旧配置 SUPERADMIN_ID 仍可用，与此项同时设置时取并集
SUPERADMIN_IDS=

# Go 服务使用 cpbot 专用 PostgreSQL 数据库，启动前需准备好 cpbot schema
CPBOT_ENGINE=go
DATABASE_URL=

# 沿用原 SQLite 路径，用于定位证明图、运行锁和旧库迁移源
DATABASE_PATH=data/cpbot.sqlite3

# 选填。Mini App 公网 HTTPS 根地址，例如 https://review.example.com/
# 填写后，重启机器人以显示私聊「查车评」按钮
CPBOT_MINI_APP_URL=

# Mini App 监听地址。HTTPS 反代或 Cloudflare Tunnel 转发到此地址
CPBOT_MINI_APP_LISTEN=127.0.0.1:8091
